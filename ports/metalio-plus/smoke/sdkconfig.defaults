# Metalio E-Ink4-Plus V1.5: ESP32-S31, 16 MB flash, octal PSRAM @ 200 MHz.
# Hardware settings match RickyOS-Plus (ports/metalio-e-ink4-plus sdkconfig.defaults).
CONFIG_IDF_TARGET="esp32s31"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_BOOT_HW_INIT=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_TASK_WDT_TIMEOUT_S=20
CONFIG_FREERTOS_HZ=1000
CONFIG_I2C_SUPPRESS_DEPRECATE_WARN=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# Panel bounce-buffer EOF interrupt must run while flash/PSRAM cache is off.
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y
